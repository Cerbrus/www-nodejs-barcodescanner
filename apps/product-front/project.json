{
    "name": "product-front",
    "$schema": "../../../node_modules/nx/schemas/project-schema.json",
    "projectType": "application",
    "prefix": "app",
    "sourceRoot": "apps/product-front/src",
    "tags": [],
    "targets": {
        "build": {
            "executor": "@angular-devkit/build-angular:application",
            "outputs": ["{options.outputPath}"],
            "defaultConfiguration": "production",
            "options": {
                "outputPath": "dist/apps/product-front",
                "index": "apps/product-front/src/index.html",
                "browser": "apps/product-front/src/main.ts",
                "tsConfig": "apps/product-front/tsconfig.app.json",
                "inlineStyleLanguage": "scss",
                "assets": [
                    "apps/product-front/src/favicon.ico",
                    {
                        "glob": "sw.js",
                        "input": "apps/product-front/src",
                        "output": "/"
                    },
                    "apps/product-front/src/assets"
                ],
                "styles": ["apps/product-front/src/styles.scss"],
                "scripts": []
            },
            "configurations": {
                "production": {
                    "budgets": [
                        {
                            "type": "initial",
                            "maximumWarning": "500kb",
                            "maximumError": "1mb"
                        },
                        {
                            "type": "anyComponentStyle",
                            "maximumWarning": "2kb",
                            "maximumError": "4kb"
                        }
                    ],
                    "outputHashing": "all"
                },
                "development": {
                    "optimization": false,
                    "extractLicenses": false,
                    "sourceMap": true
                }
            }
        },
        "serve": {
            "executor": "@angular-devkit/build-angular:dev-server",
            "defaultConfiguration": "development",
            "continuous": true,
            "configurations": {
                "production": {
                    "buildTarget": "product-front:build:production"
                },
                "development": {
                    "buildTarget": "product-front:build:development"
                }
            },
            "readyWhen": {
                "signal": true
            }
        },
        "extract-i18n": {
            "executor": "@angular-devkit/build-angular:extract-i18n",
            "options": {
                "buildTarget": "product-front:build"
            }
        }
    }
}
