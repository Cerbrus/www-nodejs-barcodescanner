{
    "extends": [
        "../../.eslintrc.json"
    ],
    "ignorePatterns": [
        "!**/*",
        "*.config.js"
    ],
    "overrides": [
        {
            "files": [
                "*.ts",
                "*.tsx",
                "*.js",
                "*.jsx"
            ],
            "rules": {}
        },
        {
            "files": [
                "*.ts",
                "*.tsx"
            ],
            "rules": {}
        },
        {
            "files": [
                "*.js",
                "*.jsx"
            ],
            "rules": {}
        },
        {
            "files": [
                "*.ts"
            ],
            "excludedFiles": [
                "src/config/app.config.ts",
                "src/test/**",
                "*.spec.ts"
            ],
            "rules": {
                "no-restricted-syntax": [
                    "error",
                    {
                        "selector": "MemberExpression[object.name='process'][property.name='env']",
                        "message": "Read settings through AppConfig (src/config/app.config.ts), not from process.env."
                    }
                ]
            }
        },
        {
            "files": [
                "src/core/**/*.ts"
            ],
            "excludedFiles": [
                "*.spec.ts"
            ],
            "rules": {
                "no-restricted-imports": [
                    "error",
                    {
                        "patterns": [
                            {
                                "group": ["**/api/**"],
                                "message": "core must not import from api: dependencies point inward (api, then core, then data)."
                            }
                        ]
                    }
                ]
            }
        },
        {
            "files": [
                "src/data/**/*.ts"
            ],
            "excludedFiles": [
                "*.spec.ts"
            ],
            "rules": {
                "no-restricted-imports": [
                    "error",
                    {
                        "patterns": [
                            {
                                "group": ["**/api/**", "**/core/**"],
                                "message": "data must not import from api or core: dependencies point inward (api, then core, then data)."
                            }
                        ]
                    }
                ]
            }
        },
        {
            "files": [
                "src/config/**/*.ts"
            ],
            "excludedFiles": [
                "*.spec.ts"
            ],
            "rules": {
                "no-restricted-imports": [
                    "error",
                    {
                        "patterns": [
                            {
                                "group": ["**/api/**", "**/core/**", "**/data/**"],
                                "message": "config must not import from the layers that read it."
                            }
                        ]
                    }
                ]
            }
        },
        {
            "files": [
                "*.spec.ts"
            ],
            "rules": {
                "max-lines-per-function": "off"
            }
        }
    ]
}
