{
    "extends": "../../tsconfig.base.json",
    "compilerOptions": {
        "target": "es2022",
        "module": "preserve",
        "moduleResolution": "bundler",
        "strict": true,
        "noImplicitReturns": true,
        "noFallthroughCasesInSwitch": true,
        "forceConsistentCasingInFileNames": true,
        "lib": ["es2023"],
        "types": ["node"],
        "noEmit": true
    },
    "include": ["src/**/*.ts"]
}
