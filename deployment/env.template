# Settings for the barcode scanner on this Pi. Never overwritten by updates.

# Image version: 'latest' follows master, a version number such as 1.0.20 pins that version.
IMAGE_TAG=latest

# Host port of the web app and API.
APP_PORT=3020

# Address of the reverse proxy; only it may reach APP_PORT. Several: comma-separated.
# The app has no login of its own, so leave this empty only on a trusted network.
ALLOWED_SOURCE=

# Scanner device: ls -l /dev/input/by-id/ and take the entry ending in -event-kbd.
SCANNER_DEVICE=/dev/input/by-id/CHANGE-ME-event-kbd

# Private git repository for the database backup, as an SSH address such as
# git@github.com:<account>/<repository>.git. Empty switches the backup off.
BACKUP_REPO=

# Contact address sent along with push notifications, as mailto:you@your-domain or an https address.
# Apple and Google only use it to reach the sender about problems.
PUSH_SUBJECT=

# Sound at the scanner: 'none' or 'buzzer' (a buzzer on a GPIO pin of this Pi).
FEEDBACK_OUTPUT=none
# GPIO number (not the physical pin number) the buzzer's plus side is connected to.
BUZZER_PIN=18
# 'active' beeps by itself when powered; 'passive' needs a tone and can do high and low.
BUZZER_TYPE=active
# 'true' for buzzer modules that sound when the pin is low.
BUZZER_ACTIVE_LOW=false

# Login with Google. Empty GOOGLE_CLIENT_ID switches login off: then only the reverse proxy guards the app.
# Client id and secret come from a Google Cloud OAuth client of type "web application" whose redirect
# address is <PUBLIC_URL>/api/v1/auth/google/callback.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Address the site is reached at, without a slash at the end, such as https://shopping.example.com
PUBLIC_URL=
# Google accounts that may log in, comma-separated.
ALLOWED_EMAILS=
# Secret the hardware agent uses instead of a login. install.sh fills it in.
AGENT_TOKEN=
