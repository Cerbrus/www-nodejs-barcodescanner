# Settings for the barcode scanner on this Pi. Never overwritten by updates.

# Image version: 'latest' follows master, a version number such as 1.0.20 pins that version.
IMAGE_TAG=latest

# Host port of the web app and API.
APP_PORT=3020

# Address of the reverse proxy; only it may reach APP_PORT. Several: comma-separated.
# The app has no login of its own, so leave this empty only on a trusted network.
ALLOWED_SOURCE=

# Scanner device: ls -l /dev/input/by-id/ and take the entry ending in -event-kbd.
SCANNER_DEVICE=/dev/input/by-id/CHANGE-ME-event-kbd

# Private git repository for the database backup, as an SSH address such as
# git@github.com:<account>/<repository>.git. Empty switches the backup off.
BACKUP_REPO=

# Contact address sent along with push notifications, as mailto:you@your-domain or an https address.
# Apple and Google only use it to reach the sender about problems.
PUSH_SUBJECT=
