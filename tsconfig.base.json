{
    "compileOnSave": false,
    "compilerOptions": {
        "rootDir": ".",
        "baseUrl": ".",
        "paths": {
            "@barcodescanner/shared": ["libs/shared/src/index.ts"]
        },
        "sourceMap": true,
        "declaration": false,
        "moduleResolution": "node",
        "emitDecoratorMetadata": true,
        "experimentalDecorators": true,
        "importHelpers": true,
        "target": "es2015",
        "module": "esnext",
        "lib": ["es2023", "dom"],
        "skipLibCheck": true,
        "skipDefaultLibCheck": true,
        "strict": false,
        "noUncheckedSideEffectImports": false,
        "types": ["*"],
        "esModuleInterop": false,
        "ignoreDeprecations": "6.0"
    },
    "exclude": ["node_modules", "tmp"]
}
