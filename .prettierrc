{
    "singleQuote": true,
    "printWidth": 120,
    "tabWidth": 4,
    "endOfLine": "lf",
    "bracketSameLine": false,
    "trailingComma": "none",
    "overrides": [
        {
            "files": "*.html",
            "options": {
                "parser": "angular"
            }
        }
    ]
}
