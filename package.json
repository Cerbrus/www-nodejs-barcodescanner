{
    "name": "barcode-scanner",
    "version": "1.1.0",
    "license": "MIT",
    "private": true,
    "scripts": {
        "product-api:build": "nx run product-api:build",
        "product-api:serve": "nx run product-api:serve",
        "product-api:lint": "nx run product-api:lint",
        "product-api:test": "node --import tsx --test apps/product-api/src/core/rules/scan-rules.spec.ts apps/product-api/src/core/rules/session.spec.ts apps/product-api/src/core/rules/content-policy.spec.ts",
        "product-api:test:integration": "TS_NODE_PROJECT=apps/product-api/tsconfig.app.json TS_NODE_TRANSPILE_ONLY=true node -r ts-node/register --test apps/product-api/src/test/modules.integration.spec.ts apps/product-api/src/test/auth.integration.spec.ts apps/product-api/src/test/routes.integration.spec.ts apps/product-api/src/test/app.integration.spec.ts",
        "product-front:build": "nx run product-front:build",
        "hardware-agent:test": "python -m unittest discover -s apps/hardware-agent -p \"test_*.py\"",
        "product-front:serve": "nx run product-front:serve",
        "product-front:lint": "nx run product-front:lint",
        "test:all": "nx run-many --target=test",
        "lint:all": "nx run-many --target=lint",
        "prettier:autofix": "yarn prettier \"./apps/**/*.{js,ts,scss,html}\" -w"
    },
    "dependencies": {
        "@angular/common": "~22.2.0",
        "@angular/compiler": "~22.2.0",
        "@angular/core": "~22.2.0",
        "@angular/forms": "~22.2.0",
