        "@angular/cli": "~22.2.0",
        "@angular/compiler-cli": "~22.2.0",
        "@angular/language-service": "~22.2.0",
        "@eslint/js": "^9.39.5",
        "@nx/angular": "24.0.6",
        "@nx/devkit": "24.0.6",
        "@nx/eslint": "24.0.6",
        "@nx/js": "24.0.6",
        "@nx/web": "24.0.6",
        "@nx/webpack": "24.0.6",
        "@schematics/angular": "~22.2.0",
        "@swc-node/register": "^1.12.1",
        "@swc/core": "^1.16.22",
        "@swc/helpers": "~0.5.24",
        "@types/better-sqlite3": "^9.6.0",
        "@types/node": "^24.19.2",
